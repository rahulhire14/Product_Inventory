<Page x:Class="Product_Inventory.Pages.GetProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Get Product">

    <Grid Background="#F4F6F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ================= HEADER ================= -->

        <Border Grid.Row="0"
                Background="White"
                Padding="28,22"
                BorderBrush="#E1E4E8"
                BorderThickness="0,0,0,1">

            <Grid>

                <StackPanel>

                    <TextBlock Text="Products"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="#202124"/>

                    <TextBlock Text="Search and view product information"
                               FontSize="13"
                               Foreground="#777777"
                               Margin="0,5,0,0"/>

                </StackPanel>


                <!-- ADD PRODUCT BUTTON -->

                <Button Content="+  ADD PRODUCT"
                        Width="145"
                        Height="40"
                        HorizontalAlignment="Right"
                        Background="#FF0000"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="AddProduct_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- ================= SEARCH PANEL ================= -->

        <Border Grid.Row="1"
                Background="White"
                Margin="25,20,25,15"
                Padding="20"
                CornerRadius="8">

            <Border.Effect>

                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="1"
                                  Opacity="0.08"/>

            </Border.Effect>


            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="2.5*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>

                </Grid.ColumnDefinitions>


                <!-- SEARCH -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,15,0">

                    <TextBlock Text="SEARCH PRODUCT ID"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <Border Height="40"
                            Background="#F8F9FA"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1"
                            CornerRadius="6">

                        <Grid>

                            <TextBlock Text="🔍"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>

                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="13"
                                     VerticalContentAlignment="Center"
                                     Padding="8,0"
                                     Margin="38,0,8,0"
                                     />

                        </Grid>

                    </Border>

                </StackPanel>


                <!-- CATEGORY -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,15,0">

                    <TextBlock Text="CATEGORY"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,7"/>

                    <ComboBox x:Name="CategoryBox"
                              Height="40"
                              FontSize="13"
                              VerticalContentAlignment="Center">

                        <ComboBoxItem Content="All Categories"
                                      IsSelected="True"/>

                        <ComboBoxItem Content="Raw Material"/>
                        <ComboBoxItem Content="Finished Product"/>
                        <ComboBoxItem Content="Packaging"/>
                        <ComboBoxItem Content="Other"/>

                    </ComboBox>

                </StackPanel>


                <!-- SEARCH BUTTON -->

                <Button Grid.Column="3"
                        Content="SEARCH"
                        Width="90"
                        Height="40"
                        Margin="0,17,8,0"
                        Background="#FF0000"
                        Foreground="White"
                        FontWeight="SemiBold"
                        FontSize="11"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SearchButton_Click">

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>


                <!-- RESET BUTTON -->

                <Button Grid.Column="4"
                        Content="RESET"
                        Width="80"
                        Height="40"
                        Margin="0,17,0,0"
                        Background="#E9ECEF"
                        Foreground="#333333"
                        FontWeight="SemiBold"
                        FontSize="11"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ResetButton_Click"
                    >

                    <Button.Template>

                        <ControlTemplate TargetType="Button">

                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6">

                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </ControlTemplate>

                    </Button.Template>

                </Button>

            </Grid>

        </Border>


        <!-- ================= PRODUCT AREA ================= -->

        <Border Grid.Row="2"
                Background="White"
                Margin="25,0,25,25"
                CornerRadius="8"
                ClipToBounds="True">

            <Border.Effect>

                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="1"
                                  Opacity="0.06"/>

            </Border.Effect>

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="ProductTable"
                          Grid.Row="0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserReorderColumns="False"
                          CanUserResizeRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EFEFEF"
                          BorderThickness="0"
                          RowHeight="46"
                          FontSize="13"
                          Foreground="#333333"
                          Background="White"
                          AlternatingRowBackground="#FAFBFC"
                          RowBackground="White"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="0">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#FAFAFA"/>
                            <Setter Property="Foreground" Value="#666666"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="15,14"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#E5E5E5"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="15,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FFF1F1"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="PRODUCT ID"
                            Binding="{Binding Product_Id}"
                            Width="1.2*"/>

                        <DataGridTextColumn Header="PRODUCT NAME"
                            Binding="{Binding Name}"
                            Width="2*"/>

                        <DataGridTextColumn Header="CATEGORY"
                            Binding="{Binding Category}"
                            Width="1.4*"/>

                        <DataGridTextColumn Header="SKU"
                            Binding="{Binding SKU}"
                            Width="1.2*"/>

                        <DataGridTextColumn Header="QUANTITY"
                            Binding="{Binding Quantity}"
                            Width="1.1*"/>

                        <DataGridTextColumn Header="PRICE"
                            Binding="{Binding Price}"
                            Width="1.2*"/>
                        <DataGridTextColumn Header="BATCH PRICE"
                        Binding="{Binding BatchPrice}"
                          Width="1.2*"/>
                        <DataGridTemplateColumn Header="ACTION" Width="2.2*">

                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                                        <!-- STOCK IN (+) -->
                                        <Button Width="34"
                        Height="34"
                        Margin="3"
                        Tag="{Binding}"
                        Click="StockIn_Click"
                        ToolTip="Add Quantity (Stock In)"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="StockInBg"
                                    Background="Transparent"
                                    CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="StockInBg" Property="Background" Value="#ECFDF5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#16A34A"
                                  Data="M19 13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                                                </Canvas>
                                            </Viewbox>

                                        </Button>


                                        <!-- STOCK OUT (-) -->
                                        <Button Width="34"
                        Height="34"
                        Margin="3"
                        Tag="{Binding}"
                        Click="StockOut_Click"
                        ToolTip="Reduce Quantity (Stock Out)"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="StockOutBg"
                                    Background="Transparent"
                                    CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="StockOutBg" Property="Background" Value="#FFF7ED"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#EA580C"
                                  Data="M19 13H5V11H19V13Z"/>
                                                </Canvas>
                                            </Viewbox>

                                        </Button>


                                        <!-- EDIT -->
                                        <Button Width="34"
                        Height="34"
                        Margin="3"
                        Tag="{Binding}"
                        Click="EditButton_Click"
                        ToolTip="Edit"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="EditBg"
                                    Background="Transparent"
                                    CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="EditBg" Property="Background" Value="#EEF2FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#2563EB"
                                  Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34a.9959.9959 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/>
                                                </Canvas>
                                            </Viewbox>

                                        </Button>


                                        <!-- DELETE -->
                                        <Button Width="34"
                        Height="34"
                        Margin="3"
                        Tag="{Binding}"
                        Click="DeleteButton_Click"
                        ToolTip="Delete"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand">

                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="DeleteBg"
                                    Background="Transparent"
                                    CornerRadius="6">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="DeleteBg" Property="Background" Value="#FEF2F2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>

                                            <Viewbox Width="17" Height="17">
                                                <Canvas Width="24" Height="24">
                                                    <Path Fill="#DC2626"
                                  Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                </Canvas>
                                            </Viewbox>

                                        </Button>

                                    </StackPanel>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>
                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

        </Border>

    </Grid>

</Page>
