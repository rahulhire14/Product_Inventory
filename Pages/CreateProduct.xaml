<Page x:Class="Product_Inventory.Pages.CreateProduct"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Product_Inventory.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CreateProduct">

    <Grid Background="#F4F6F8">

        <Border Width="650"
            Padding="30"
            Background="White"
            CornerRadius="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Add New Product"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#20252B"
                       Margin="0,0,0,25"/>


                <!-- Product Name -->
                <TextBlock Text="Product Name"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                <TextBox x:Name="NameBox"
                     Height="40"
                     Padding="10"
                     Margin="0,0,0,15"/>


                <!-- Category -->
                <TextBlock Text="Category"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                <ComboBox x:Name="CategoryBox"
                      Height="40"
                      Padding="10"
                      Margin="0,0,0,15">

                    <ComboBoxItem Content="Medicine"/>
                    <ComboBoxItem Content="Electronics"/>
                    <ComboBoxItem Content="Food"/>
                    <ComboBoxItem Content="General"/>

                </ComboBox>


                <!-- Quantity -->
                <TextBlock Text="Quantity"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                <TextBox x:Name="QuantityBox"
                     Height="40"
                     Padding="10"
                     Margin="0,0,0,15"/>


                <!-- Price -->
                <TextBlock Text="Price"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                <TextBox x:Name="PriceBox"
                     Height="40"
                     Padding="10"
                     Margin="0,0,0,15"/>


                <!-- SKU -->
                <TextBlock Text="SKU"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6"/>

                <TextBox x:Name="SKUBox"
                     Height="40"
                     Padding="10"
                     Margin="0,0,0,15"/>


                <!-- Active -->
                <CheckBox x:Name="ActiveCheckBox"
                      Content="Active Product"
                      IsChecked="True"
                      FontWeight="SemiBold"
                      Margin="0,0,0,25"/>


                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                    <Button Content="Cancel"
                        Width="100"
                        Height="40"
                        Margin="0,0,10,0"
                        Click="CancelProduct_Click"    />

                    <Button Content="Create Product"
                        Width="140"
                        Height="40"
                        Background="#D90000"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CreateProduct_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Page>
