<Page x:Class="Product_Inventory.Pages.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Login">

    <Grid Background="#F4F6F8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="0.85*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= LEFT SIDE ================= -->

        <Border Grid.Column="0"
                Background="#171A1F">

            <Grid>

                <!-- Decorative Red Shape -->
                <Ellipse Width="420"
                         Height="420"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Bottom"
                         Margin="-180,0,0,-180"
                         Fill="#22FF0000"/>

                <Ellipse Width="280"
                         Height="280"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-130,-100,0"
                         Fill="#18FF0000"/>


                <StackPanel VerticalAlignment="Center"
                            Margin="90,0,50,0">

                    <!-- Logo -->

                    <Border Width="76"
                            Height="76"
                            CornerRadius="38"
                            Background="#FF0000"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,25">

                        <TextBlock Text="S"
                                   FontSize="40"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <TextBlock Text="SCANTECH"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="PRODUCT INVENTORY"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="#FF3B3B"
                               Margin="0,8,0,25"/>


                    <TextBlock Text="Inventory Management System"
                               FontSize="27"
                               FontWeight="SemiBold"
                               Foreground="White"
                               TextWrapping="Wrap"
                               MaxWidth="450"/>


                    <TextBlock Text="Manage products, stock, suppliers and inventory operations from one centralized system."
                               FontSize="14"
                               Foreground="#AEB4BC"
                               TextWrapping="Wrap"
                               MaxWidth="460"
                               LineHeight="23"
                               Margin="0,15,0,0"/>


                    <!-- Bottom Information -->

                    <StackPanel Orientation="Horizontal"
                                Margin="0,45,0,0">

                        <Border Width="6"
                                Height="6"
                                CornerRadius="3"
                                Background="#FF0000"
                                VerticalAlignment="Center"/>

                        <TextBlock Text=" Secure &amp; Reliable"
                                   FontSize="12"
                                   Foreground="#AEB4BC"
                                   Margin="10,0,0,0"/>

                        <Border Width="6"
                                Height="6"
                                CornerRadius="3"
                                Background="#FF0000"
                                VerticalAlignment="Center"
                                Margin="25,0,0,0"/>

                        <TextBlock Text=" Real-time Inventory"
                                   FontSize="12"
                                   Foreground="#AEB4BC"
                                   Margin="10,0,0,0"/>

                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================= RIGHT SIDE ================= -->

        <Grid Grid.Column="1"
              Background="#F4F6F8">

            <Border Width="430"
                    Padding="45"
                    Background="White"
                    CornerRadius="12"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

                <Border.Effect>

                    <DropShadowEffect BlurRadius="25"
                                      ShadowDepth="4"
                                      Opacity="0.12"/>

                </Border.Effect>


                <StackPanel>


                    <!-- Login Heading -->

                    <TextBlock Text="Welcome Back"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="#202124"/>

                    <TextBlock Text="Sign in to access your inventory dashboard"
                               FontSize="13"
                               Foreground="#777777"
                               Margin="0,7,0,30"/>


                    <!-- USERNAME -->

                    <TextBlock Text="USERNAME"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,8"/>


                    <Border Height="45"
                            Background="#F8F9FA"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1"
                            CornerRadius="7"
                            Margin="0,0,0,20">

                        <Grid>

                            <TextBlock Text="👤"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="13,0,0,0"/>

                            <TextBox x:Name="UsernameBox"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="14"
                                     Padding="8,0"
                                     Margin="40,0,10,0"
                                     VerticalContentAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- PASSWORD -->

                    <TextBlock Text="PASSWORD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,8"/>


                    <Border Height="45"
                            Background="#F8F9FA"
                            BorderBrush="#D9DDE3"
                            BorderThickness="1"
                            CornerRadius="7"
                            Margin="0,0,0,10">

                        <Grid>

                            <TextBlock Text="🔒"
                                       FontSize="15"
                                       VerticalAlignment="Center"
                                       Margin="13,0,0,0"/>

                            <PasswordBox x:Name="PasswordBox"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         FontSize="14"
                                         Padding="8,0"
                                         Margin="40,0,10,0"
                                         VerticalContentAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- ERROR -->

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="#D32F2F"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="2,0,0,15"/>


                    <!-- LOGIN BUTTON -->

                    <Button Content="LOGIN"
                            Height="46"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="White"
                            Background="#FF0000"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="LoginButton_Click">

                        <Button.Style>

                            <Style TargetType="Button">

                                <Setter Property="Background"
                                        Value="#FF0000"/>

                                <Setter Property="Foreground"
                                        Value="White"/>

                                <Setter Property="BorderThickness"
                                        Value="0"/>

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="7">

                                                <ContentPresenter
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>


                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver"
                                             Value="True">

                                        <Setter Property="Background"
                                                Value="#D90000"/>

                                    </Trigger>


                                    <Trigger Property="IsPressed"
                                             Value="True">

                                        <Setter Property="Background"
                                                Value="#B80000"/>

                                    </Trigger>


                                    <Trigger Property="IsEnabled"
                                             Value="False">

                                        <Setter Property="Background"
                                                Value="#CCCCCC"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Button.Style>

                    </Button>


                    <!-- FOOTER -->

                    <TextBlock Text="© 2026 SCANTECH"
                               FontSize="11"
                               Foreground="#AAAAAA"
                               HorizontalAlignment="Center"
                               Margin="0,30,0,0"/>

                </StackPanel>

            </Border>

        </Grid>

    </Grid>

</Page>