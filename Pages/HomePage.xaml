<Page x:Class="Product_Inventory.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Product_Inventory.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage">

    
    <Grid Background="#F4F6F8">

        <Grid.ColumnDefinitions>
            <!-- Sidebar -->
            <ColumnDefinition Width="230"/>

            <!-- Main Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ================= SIDEBAR ================= -->

        <Border Grid.Column="0"
            Background="#20252B">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>


                <!-- Logo -->
                <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        Margin="25,0">

                    <TextBlock Text="Inventory Management"
                           Foreground="#AEB4BA"
                           FontSize="11"
                           Margin="0,4,0,0"/>
                </StackPanel>


                <!-- Navigation -->
                <StackPanel Grid.Row="1"
                        Margin="12,20,12,0">

                    <!-- Dashboard -->
                    <Button Content="⌂   Dashboard"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="White"
                        Background="#D90000"
                        BorderThickness="0"/>

                    <!-- Products -->
                    <Button Content="▣   Products"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="#D5D8DC"
                        Background="Transparent"
                        BorderThickness="0" Click="ProductsButton_Click"/>
                    <StackPanel x:Name="ProductsMenu" Visibility="Collapsed" Margin="20,0,0,6">
                        <Button Content="Add Product" Height="38" HorizontalContentAlignment="Left" Padding="20,0" FontSize="13" Foreground="#BFC5CB" Background="Transparent" BorderThickness="0" Click="AddProduct_Click"/>
                        <Button Content="Product List" Height="38" HorizontalContentAlignment="Left" Padding="20,0" FontSize="13" Foreground="#BFC5CB" Background="Transparent" BorderThickness="0" Click="GetProductList_Click" />
                        <Button Content="Categories" Height="38" HorizontalContentAlignment="Left" Padding="20,0" FontSize="13" Foreground="#BFC5CB" Background="Transparent" BorderThickness="0" />
                    </StackPanel>

                    <!-- Inventory -->
                    <Button Content="▤   Inventory"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="#D5D8DC"
                        Background="Transparent"
                        BorderThickness="0"/>

                    <!-- Stock -->
                    <Button Content="⇅   Stock In / Out"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="#D5D8DC"
                        Background="Transparent"
                        BorderThickness="0" Click="GetStockEntries_Click"/>

                    <!-- Suppliers -->
                    <Button Content="♙   Suppliers"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="#D5D8DC"
                        Background="Transparent"
                        BorderThickness="0"/>

                    <!-- Reports -->
                    <Button Content="▥   Reports"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="#D5D8DC"
                        Background="Transparent"
                        BorderThickness="0"/>

                    <!-- Users -->
                    <Button Content="♟   Users"
                        Height="45"
                        Margin="0,0,0,6"
                        HorizontalContentAlignment="Left"
                        Padding="18,0"
                        FontSize="14"
                        Foreground="#D5D8DC"
                        Background="Transparent"
                        BorderThickness="0"/>

                </StackPanel>


                <!-- Bottom -->
                <StackPanel Grid.Row="2"
                        VerticalAlignment="Center"
                        Margin="20,0">

                    <TextBlock Text="⚙  Settings"
                           Foreground="#AEB4BA"
                           FontSize="13"
                           Margin="0,0,0,8"/>

                    <TextBlock Text="↪  Logout"
                           Foreground="#FF6B6B"
                           FontSize="13"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ================= MAIN AREA ================= -->

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>

                <!-- Header -->
                <RowDefinition Height="70"/>

                <!-- Content -->
                <RowDefinition Height="*"/>

            </Grid.RowDefinitions>


            <!-- ================= HEADER ================= -->

            <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E1E4E8"
                BorderThickness="0,0,0,1">

                <Grid Margin="25,0">

                    <TextBlock Text="Dashboard"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="#20252B"
                           VerticalAlignment="Center"/>


                    <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                        <TextBlock Text="Welcome,"
                               Foreground="#777777"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                        <TextBlock Text=" Admin"
                               Foreground="#20252B"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================= DASHBOARD CONTENT ================= -->

            <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="30">


                    <!-- Page Heading -->

                    <TextBlock Text="Inventory Overview"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="#20252B"/>
                    <Button Content=" OUT PRODUCT"
                                      Width="145"
                                      Height="40"
                                      HorizontalAlignment="Right"
                                      Background="Green"
                                      Foreground="White"
                                      FontSize="12"
                                      FontWeight="Bold"
                                      BorderThickness="0"
                                      Cursor="Hand"
                                      Click="OutProduct_Click">     

                                    <Button.Template>

                            <ControlTemplate TargetType="Button">

                                <Border Background="{TemplateBinding Background}"
                      CornerRadius="6">

                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                </Border>

                            </ControlTemplate>

                        </Button.Template>

                    </Button>

                    <TextBlock Text="Monitor your inventory and stock activities"
                           FontSize="13"
                           Foreground="#777777"
                           Margin="0,5,0,25"/>
                     

                    <!-- ================= CARDS ================= -->

                    <UniformGrid Columns="4"
                             Margin="0,0,0,25">

                        <!-- Products -->
                        <Border Background="White"
                            CornerRadius="10"
                            Margin="0,0,15,0"
                            Padding="20">

                            <StackPanel>

                                <TextBlock Text="TOTAL PRODUCTS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Text="0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#20252B"
                                       Margin="0,8,0,0"/>

                                <TextBlock Text="Products registered"
                                       FontSize="11"
                                       Foreground="#999999"/>

                            </StackPanel>

                        </Border>


                        <!-- Stock -->
                        <Border Background="White"
                            CornerRadius="10"
                            Margin="0,0,15,0"
                            Padding="20">

                            <StackPanel>

                                <TextBlock Text="TOTAL STOCK"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Text="0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#20252B"
                                       Margin="0,8,0,0"/>

                                <TextBlock Text="Units available"
                                       FontSize="11"
                                       Foreground="#999999"/>

                            </StackPanel>

                        </Border>


                        <!-- Low Stock -->
                        <Border Background="White"
                            CornerRadius="10"
                            Margin="0,0,15,0"
                            Padding="20">

                            <StackPanel>

                                <TextBlock Text="LOW STOCK"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Text="0.0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#E67E22"
                                       Margin="0,8,0,0"/>

                                <TextBlock Text="Items need attention"
                                       FontSize="11"
                                       Foreground="#999999"/>

                            </StackPanel>

                        </Border>


                        <!-- Out of Stock -->
                        <Border Background="White"
                            CornerRadius="10"
                            Padding="20">

                            <StackPanel>

                                <TextBlock Text="OUT OF STOCK"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Text="0"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#D90000"
                                       Margin="0,8,0,0"/>

                                <TextBlock Text="Items unavailable"
                                       FontSize="11"
                                       Foreground="#999999"/>

                            </StackPanel>

                        </Border>

                    </UniformGrid>


                    <!-- ================= RECENT ACTIVITY ================= -->

                    <Border Background="White"
                        CornerRadius="10"
                        Padding="25">

                        <StackPanel>

                            <TextBlock Text="Recent Stock Activity"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="#20252B"/>

                            <TextBlock Text="Latest inventory transactions"
                                   FontSize="12"
                                   Foreground="#888888"
                                   Margin="0,4,0,20"/>


                            <!-- Table Header -->

                            <Grid Margin="0,0,0,10">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="PRODUCT"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Grid.Column="1"
                                       Text="TYPE"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Grid.Column="2"
                                       Text="QUANTITY"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                                <TextBlock Grid.Column="3"
                                       Text="DATE"
                                       FontWeight="SemiBold"
                                       Foreground="#777777"/>

                            </Grid>


                            <!-- Row 1 -->

                            <Grid Margin="0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Paracetamol 500mg"/>

                                <TextBlock Grid.Column="1"
                                       Text="Stock In"
                                       Foreground="Green"/>

                                <TextBlock Grid.Column="2"
                                       Text="500"/>

                                <TextBlock Grid.Column="3"
                                       Text="23 Sep 2026"/>

                            </Grid>


                            <!-- Row 2 -->

                            <Grid Margin="0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Amoxicillin 250mg"/>

                                <TextBlock Grid.Column="1"
                                       Text="Stock Out"
                                       Foreground="#D90000"/>

                                <TextBlock Grid.Column="2"
                                       Text="120"/>

                                <TextBlock Grid.Column="3"
                                       Text="23 Sep 2026"/>

                            </Grid>


                            <!-- Row 3 -->

                            <Grid Margin="0,12">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Cetirizine 10mg"/>

                                <TextBlock Grid.Column="1"
                                       Text="Stock In"
                                       Foreground="Green"/>

                                <TextBlock Grid.Column="2"
                                       Text="250"/>

                                <TextBlock Grid.Column="3"
                                       Text="22 Sep 2026"/>

                            </Grid>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>
    

</Page>
