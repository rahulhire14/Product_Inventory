<Window x:Class="Product_Inventory.Pop_up.StockUpDatePop"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Stock"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- HEADER (icon + title changes based on mode) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">

            <Border x:Name="ModeIconBg"
                    Width="34" Height="34"
                    CornerRadius="17"
                    Background="#ECFDF5"
                    Margin="0,0,10,0">
                <TextBlock x:Name="ModeIcon"
                           Text="+"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#16A34A"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText"
                           Text="Add Stock"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#202124"/>
                <TextBlock x:Name="SubtitleText"
                           Text="Increase quantity for this product"
                           FontSize="11"
                           Foreground="#777777"/>
            </StackPanel>

        </StackPanel>


        <!-- PRODUCT INFO -->
        <Border Grid.Row="1"
                Background="#F8F9FA"
                BorderBrush="#E1E4E8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14,10"
                Margin="0,14,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PRODUCT" FontSize="9" FontWeight="SemiBold" Foreground="#999999"/>
                    <TextBlock x:Name="ProductNameText" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#202124" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="CURRENT QUANTITY" FontSize="9" FontWeight="SemiBold" Foreground="#999999"/>
                    <TextBlock x:Name= "CurrentQtyText" Text="{Binding Quantity}" FontSize="13" FontWeight="SemiBold" Foreground="#202124"/>
                </StackPanel>

            </Grid>

        </Border>


        <!-- QUANTITY INPUT -->
        <StackPanel Grid.Row="2" Margin="0,18,0,0">

            <TextBlock x:Name="QtyLabel"
                       Text="QUANTITY TO ADD"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       Margin="0,0,0,7"/>

            <Border Height="42"
                    Background="#F8F9FA"
                    BorderBrush="#D9DDE3"
                    BorderThickness="1"
                    CornerRadius="6">

                <TextBox x:Name="QuantityBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         Padding="12,0" TextChanged="QuantityBox_TextChanged" 
                         
                         />

            </Border>

        </StackPanel>


        <!-- RESULTING QUANTITY PREVIEW -->
        <TextBlock x:Name="ResultPreviewText"
                   Grid.Row="3"
                   Text=""
                   FontSize="11"
                   Foreground="#16A34A"
                   Margin="2,7,0,0"/>


        <!-- REMARKS -->
        <StackPanel Grid.Row="4" Margin="0,14,0,0">

            <TextBlock Text="REMARKS (OPTIONAL)"
                       FontSize="10"
                       FontWeight="SemiBold"
                       Foreground="#555555"
                       Margin="0,0,0,7"/>

            <Border Height="42"
                    Background="#F8F9FA"
                    BorderBrush="#D9DDE3"
                    BorderThickness="1"
                    CornerRadius="6">

                <TextBox x:Name="RemarksBox"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         VerticalContentAlignment="Center"
                         Padding="12,0" TextChanged="RemarksBox_TextChanged"/>

            </Border>

        </StackPanel>


        <!-- VALIDATION MESSAGE -->
        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Text=""
                   FontSize="11"
                   Foreground="#DC2626"
                   Margin="2,10,0,0"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>


        <!-- ACTION BUTTONS -->
        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">

            <Button Content="CANCEL"
                    Width="90"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#E9ECEF"
                    Foreground="#333333"
                    FontWeight="SemiBold"
                    FontSize="11"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

            <Button x:Name="ConfirmButton"
                    Content="CONFIRM"
                    Width="110"
                    Height="38"
                    Background="#16A34A"
                    Foreground="White"
                    FontWeight="SemiBold"
                    FontSize="11"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="ConfirmButton_Click">

                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>

            </Button>

        </StackPanel>

    </Grid>

</Window>